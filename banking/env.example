# Rename file ini menjadi .env saat konfigurasi akan digunakan.
# Jangan isi secret asli di file contoh yang akan dibagikan.

# App
NEXT_PUBLIC_APP_NAME=NovaBank Digital
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API / Backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Auth
AUTH_SECRET=change-this-secret
AUTH_SESSION_MAX_AGE=86400

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/novabank
